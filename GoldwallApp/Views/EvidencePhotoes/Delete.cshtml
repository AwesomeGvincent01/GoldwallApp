@model GoldwallApp.Models.EvidencePhoto

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Delete Evidence Photo";
    ViewData["ActivePage"] = "EvidencePhotos";
}

<h1>Delete Evidence Photo</h1>

<p class="gw-warning-text">
    Are you sure you want to delete this evidence photo?
</p>

<div class="gw-crud-card">

    @if (!string.IsNullOrEmpty(Model.FileUrl))
    {
        <div class="mb-3">
            <img src="@Model.FileUrl" width="260" class="rounded" />
        </div>
    }

    <dl class="row mb-0">

        <dt class="col-sm-3 gw-detail-label">
            Caption
        </dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Caption))
            {
                <span class="text-muted">No caption entered</span>
            }
            else
            {
                @Model.Caption
            }
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Taken At
        </dt>
        <dd class="col-sm-9">
            @Model.TakenAt.ToString("dd MMM yyyy, h:mm tt")
        </dd>

    </dl>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="EvidencePhotoId" />
    <input type="submit" value="Delete" class="btn btn-danger fw-bold" />
    <a asp-action="Gallery" class="gw-back-link ms-2">Back to Gallery</a>
</form>