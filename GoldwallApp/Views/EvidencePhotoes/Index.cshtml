@model IEnumerable<GoldwallApp.Models.EvidencePhoto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WorkEventId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DefectReportId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FileUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Caption)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TakenAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.WorkEventId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DefectReportId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FileUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Caption)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TakenAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EvidencePhotoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EvidencePhotoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EvidencePhotoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
