@model IEnumerable<GoldwallApp.Models.EvidencePhoto>

@{
    ViewData["Title"] = "Index";
}

<style>
  body {
    background-image: linear-gradient(rgba(255, 253, 242, 0.88), rgba(244, 231, 179, 0.92)), url('/images/ui/GWBackground.png');
     background-size: cover;
    background-position: center;
     background-attachment: fixed;
    }

  h1 {
    font-weight: 800;
   color: #4a3a12;
     text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
  }

  .card {
     background-color: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(150, 120, 35, 0.18);
      border-radius: 16px;
     box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);
    }


    .evidence-photo-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 12px;
    }
</style>

@{
    var selectedPhoto = Model.FirstOrDefault(); //show latest photos for preview
}

<div class="d-flex justify-content-between align-items-start mb-4"> 
    <div>
<h1>Evidence photos / gallery</h1> 

<p>upload and manage job site evidence photos</p>


</div>


    <a asp-action="Create" class="btn btn-warning fw-bold px-4">Upload Photo</a>
    </div>

<table class="table">
    <thead>
        <tr>
            <th>
                Image @* //new *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkEventId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DefectReportId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FileUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Caption)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TakenAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* //new *@
                    @if (!string.IsNullOrEmpty(item.FileUrl)) @* //new *@
                    {
                        <img src="@item.FileUrl" width="120" /> @* //new *@
                    }
                </td> @* //new *@
                <td>
                    @Html.DisplayFor(modelItem => item.WorkEventId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DefectReportId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FileUrl)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Caption)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TakenAt)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EvidencePhotoId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EvidencePhotoId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EvidencePhotoId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>