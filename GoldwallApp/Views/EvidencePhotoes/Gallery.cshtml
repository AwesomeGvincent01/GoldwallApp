@* Evidence Photos Gallery. IMPORTANT: this page uses EvidencePhotosViewModel instead of IEnumerable<EvidencePhoto> because it needs to display additional information beyond just the photo data.*@


@model GoldwallApp.ViewModels.EvidencePhotosViewModel

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Evidence Photos";

}

<style>
    body {
        background-image: linear-gradient(rgba(255, 253, 242, 0.88), rgba(244, 231, 179, 0.92)), url('/images/ui/GWBackground.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    h1 {
        font-weight: 800;
        color: #4a3a12;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .card {
        background-color: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(150, 120, 35, 0.18);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);
    }

 .evidence-photo-img {
       width: 100%;
    height: 160px;
      object-fit: cover;
    border-radius: 12px;
}
</style>






<div class="d-flex justify-content-between align-items-start mb-4"> @*this bootstrap d-flex thingy majig puts the title/logo on the left and the upload button on the right*@
    <div>
        <h1>Evidence Photos / Gallery</h1>
        <p>Upload and manage job-site evidence photos.</p>
    </div>

    @*this links to the existing scaffolded create action. i pretty much just copied this from evidencephotos create, and im modifying it by changing the class here*@
             <a asp-action="Create" class="btn btn-warning fw-bold px-4">Upload Photo</a>
                 </div>


                 @*filter cards. currently just placeholders.*@
<div class="card card-body mb-4">
  <div class="row g-3">

     <div class="col-md-3">
               <input class="form-control" placeholder="Search caption..." />
        </div>

        <div class="col-md-3">
         <select class="form-select">
              <option>Filter by Job</option>
       </select>
                   </div>

        <div class="col-md-3">
            <select class="form-select">
                <option>Filter by Defect</option>
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select">
                <option>Sort by Date</option>
            </select>
        </div>

    </div>
</div>




@*IMPORTANT: This is the main content area for the evidence photos gallery. Left side is the photo grid/gallery, right side is the selected photo details*@


<div class="row g-4">


    @*Left column: takes up 8 columns on large screens.*@
    <div class="col-lg-8">
        <div class="card card-body">
            <h4 class="mb-3">Photo Gallery</h4>

            @*checks whether the viewmodel contains any evidence photos, otherwise display a message that says "No evidence photos have been uploaded yet."*@
            @if (Model.EvidencePhotos.Any())
            {
                <div class="row g-4">

                    @*loops through every evidence photo in the viewmodel and creates a card for each item. so essentially its the reason the photos are able to be displayed in a grid*@

                    @foreach (var item in Model.EvidencePhotos)
                    {
                  <div class="col-md-6 col-xl-4">

                       <div class="card card-body h-100">
                           @*only show an image if the photo has a saved FileUrl, otherwise it just shows nothing*@
                        @if (!string.IsNullOrEmpty(item.FileUrl))
                                {
                                    <img src="@item.FileUrl"
                                         class="evidence-photo-img mb-3"
                                         alt="@item.Caption" />
                                }

                                @*shows the caption, if none, shows fallback text aka "No caption"*@

                                <p class="mb-1">
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(item.Caption)
                                            ? "No caption"
                                            : item.Caption)
                                    </strong>
                                </p>

                                @*displays the date in a readable format*@

                                <p class="text-muted mb-3">
                                    @item.TakenAt.ToString("dd MMM yyyy")
                                </p>


                                @*button row for actions AN evidence photo*@
                                <div class="d-flex gap-2 flex-wrap mt-auto">


                                    @*IMPORTANT: this reloads the gallery page, passes the selected photo's ID which is used to display the selected photo details*@

                                    <a asp-action="Gallery"
                                       asp-route-selectedPhotoId="@item.EvidencePhotoId"
                                       class="btn btn-sm btn-warning fw-bold">
                                        View
                                    </a>


                                    @*links to the existing scaffolded edit page, which will be modified*@
                                    <a asp-action="Edit"
                                       asp-route-id="@item.EvidencePhotoId"
                                       class="btn btn-sm btn-warning fw-bold">
                                        Edit
                                    </a>

                                    @*links to existing scaffolded delete page, which will be modified*@
                                    <a asp-action="Delete"
                                       asp-route-id="@item.EvidencePhotoId"
                                       class="btn btn-sm btn-danger fw-bold">
                                        Delete
                                    </a>

                           </div>

                          </div>

                        </div>
                    }

                          </div>
            }
            else
            {
@*Message shown if there are no evidence photo records (rows) in the database*@

                <p class="text-muted mb-0">
                    No evidence photos have  uploaded yet.
                </p>
            }

        </div>
    </div>

    @*Right column: takes up 4 columns on large screens.*@

    <div class="col-lg-4">

        <div class="card card-body">
            <h4 class="mb-3">Selected Photo Details</h4>


            @*IMPORTANT: selectedphoto comes from viewmodel. the controller chooses it based on the selectedphotoid when user clicks view on a photo. if no photo has been selected yet, the controller just displays the first photo in the list. so when you first load the page, the first photo will be displayed by default. if there are no photos in the database, that's when nothing is displayed/selected photo is null. also, if it clicks view for a selectedphotoid that somehow doesnt exist anymore, the controller also falls back to the first photo.*@

            @if (Model.SelectedPhoto != null)
            {
                var selectedPhoto = Model.SelectedPhoto;


                @*shows a large image/preview of the selected photo*@

                @if (!string.IsNullOrEmpty(selectedPhoto.FileUrl))
                {
                         <img src="@selectedPhoto.FileUrl"
                         class="img-fluid rounded mb-3"
                         alt="@selectedPhoto.Caption" />
                }

                <p>
                    <strong>Caption:</strong>

                    @(string.IsNullOrWhiteSpace(selectedPhoto.Caption)
                        ? "No caption"
                        : selectedPhoto.Caption)
                </p>

                <p>
                    <strong>Job:</strong>


                    @*this follows the relationship chain being: evidencephoto -> workevent -> surface -> room -> job. the question marks stop the page from crashing if any part of the chain is null, to which we fall back to "Not available" message for if any part of it is null.*@

                    @(selectedPhoto.WorkEvent?
              .Surface?
                          .Room?
                          .Job?
                          .Title ?? "Not available")
                </p>

                <p>
                    <strong>Work Event:</strong>

                    @*shows the work event notes. if missing, shows work event ID instead, as per the '??'*@

               @(selectedPhoto.WorkEvent?.Notes
                              ?? ("Work event #" + selectedPhoto.WorkEventId))
                </p>

                <p>
                    <strong>Defect:</strong>

                    @*shows the linked defect type if photo is linked to a defect report*@
            @(selectedPhoto.DefectReport?
                           .DefectType?
                          .Name ?? "Not linked")
                </p>

                <p>
                    <strong>Taken At:</strong>

                    @*shows the date and time the photo was taken*@
                    @selectedPhoto.TakenAt.ToString("dd MMM yyyy, h:mm tt")
                </p>

                <div class="d-flex gap-2 flex-wrap">

                    @*links to the existing scaffolded edit page, which will be modified*@

                    <a asp-action="Edit"
                    asp-route-id="@selectedPhoto.EvidencePhotoId"
                    class="btn btn-warning fw-bold">
                        Replace Image
                    </a>

                    @*the download link uses image file path. so basically, what it does is first check if the file URL is available, and if so, create a link to download the image through the browser.*@
                    @if (!string.IsNullOrEmpty(selectedPhoto.FileUrl))
                    {
                        <a href="@selectedPhoto.FileUrl"
                    download
                       class="btn btn-warning fw-bold">
                            Download
                        </a>
                    }
                    @*uses existing scaffolded delete page*@
                    <a asp-action="Delete"
         asp-route-id="@selectedPhoto.EvidencePhotoId"
                       class="btn btn-danger fw-bold">
                        Delete
                    </a>

                </div>
            }
            else
            {

                @*message shown if there are no photos to select*@
                <p class="text-muted mb-0">
                    No phto available to display.
                </p>
            }

        </div>
    </div>

</div>