@model GoldwallApp.Models.EvidencePhoto

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Upload Evidence Photo";
    ViewData["ActivePage"] = "EvidencePhotos";
}

<h1>Upload Evidence Photo</h1>

<p class="text-muted">
    Add a new job site photo and link it to a work event or defect.
</p>

<div class="gw-crud-card gw-form-width">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="WorkEventId" class="control-label">Work Event</label>
            <select asp-for="WorkEventId" class="form-control" asp-items="ViewBag.WorkEventId"></select>
            <span asp-validation-for="WorkEventId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DefectReportId" class="control-label">Defect Report</label>
            <select asp-for="DefectReportId" class="form-control" asp-items="ViewBag.DefectReportId">
                <option value="">None</option>
            </select>
            <span asp-validation-for="DefectReportId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ImageFile" class="control-label">Image File</label>
            <input asp-for="ImageFile" type="file" class="form-control" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Caption" class="control-label"></label>
            <input asp-for="Caption" class="form-control" />
            <span asp-validation-for="Caption" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TakenAt" class="control-label"></label>
            <input asp-for="TakenAt" class="form-control" />
            <span asp-validation-for="TakenAt" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <input type="submit" value="Upload" class="btn btn-warning fw-bold" />
            <a asp-action="Gallery" class="gw-back-link ms-2">Back to Gallery</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}