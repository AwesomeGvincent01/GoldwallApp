@model IEnumerable<GoldwallApp.Models.EventContext>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaterialId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThicknessMm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HumidityPct)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemperatureC)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VentilationRating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSincePrevEventHours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MixRatio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaterialId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ThicknessMm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HumidityPct)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemperatureC)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VentilationRating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TimeSincePrevEventHours)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MixRatio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WorkEventId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WorkEventId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WorkEventId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
