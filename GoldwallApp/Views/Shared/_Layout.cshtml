<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Goldwall App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="container">
        <h1>Goldwall App</h1>

        <p>
            <a asp-controller="Home" asp-action="Index">Home</a> |
            <a asp-controller="Home" asp-action="About">About</a> |
            <a asp-controller="Businesses" asp-action="Index">Businesses</a> |
            <a asp-controller="Users" asp-action="Index">Users</a> |
            <a asp-controller="Clients" asp-action="Index">Clients</a> |
            <a asp-controller="Jobs" asp-action="Index">Jobs</a> |
            <a asp-controller="Rooms" asp-action="Index">Rooms</a> |
            <a asp-controller="Surfaces" asp-action="Index">Surfaces</a> |
            <a asp-controller="EventTypes" asp-action="Index">EventTypes</a> |
            <a asp-controller="WorkEvents" asp-action="Index">WorkEvents</a>
            <a asp-controller="Materials" asp-action="Index">Materials</a>
        </p>

        <hr />

        @RenderBody()

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>