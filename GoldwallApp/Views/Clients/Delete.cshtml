@model GoldwallApp.Models.Client

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Delete Client";
    ViewData["ActivePage"] = "Clients";
}

<h1>Delete Client</h1>

<p class="gw-warning-text">
    Are you sure you want to delete this client?
</p>

<div class="gw-crud-card">
    <dl class="row mb-0">

        <dt class="col-sm-3 gw-detail-label">
            Name
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Phone
        </dt>
        <dd class="col-sm-9">
            @Model.Phone
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Email
        </dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Email))
            {
                <span class="text-muted">No email entered</span>
            }
            else
            {
                @Model.Email
            }
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Created At
        </dt>
        <dd class="col-sm-9">
            @Model.CreatedAt.ToString("dd MMM yyyy")
        </dd>

    </dl>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="ClientId" />
    <input type="submit" value="Delete" class="btn btn-danger fw-bold" />
    <a asp-action="ClientList" class="gw-back-link ms-2">Back to Clients</a>
</form>