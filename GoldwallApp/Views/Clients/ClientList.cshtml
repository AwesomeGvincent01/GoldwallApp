@model GoldwallApp.ViewModels.ClientsViewModel

@{
    ViewData["Title"] = "Clients";
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
}

<style>
    body {
        background-image: linear-gradient(rgba(255,253,242,0.88), rgba(244,231,179,0.92)), url('/images/ui/GWBackground.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .goldwall-card {
        background-color: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(150, 120, 35, 0.18);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);
    }

    .goldwall-heading {
        font-weight: 800;
        color: #4a3a12;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .summary-number {
        font-size: 1.7rem;
        font-weight: 800;
        color: #5a4510;
    }

    .table th {
        color: #4a3a12;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="goldwall-heading">Clients</h1>
            <p class="text-muted mb-0">
                Manage client contact details for Goldwall jobs.
                                 </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-bold">
            Add Client
        </a>
    </div>

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Total Clients</div>
                <div class="summary-number">@Model.TotalClientsCount</div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">With Email</div>
                <div class="summary-number">@Model.ClientsWithEmailCount</div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Without Email</div>
                <div class="summary-number">@Model.ClientsWithoutEmailCount</div>
            </div>
        </div>

    </div>

    <div class="goldwall-card p-3">

        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Client</th>
                          <th>Phone</th>
                    <th>Email</th>
                    <th>Business</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var client in Model.ClientsList)
                {
                    <tr>
                        <td class="fw-bold">@client.Name</td>

                        <td>@client.Phone</td>

                        <td>
                            @if (string.IsNullOrWhiteSpace(client.Email))
                            {
                                <span class="text-muted">Not entered</span>
                            }
                            else
                            {
                                @client.Email
                            }
                        </td>

                        <td>
                            @(client.Business?.Name ?? "No business linked")
                        </td>

                        <td>
                            @client.CreatedAt.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@client.ClientId" class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-action="Edit" asp-route-id="@client.ClientId" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@client.ClientId" class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>