@model GoldwallApp.Models.Client

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Client Details";
    ViewData["ActivePage"] = "Clients";
}

<h1>Client Details</h1>

<p class="text-muted">
    View the saved contact information for this client.
</p>

<div class="gw-crud-card">
    <dl class="row mb-0">

        <dt class="col-sm-3 gw-detail-label">
            Name
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Phone
        </dt>
        <dd class="col-sm-9">
            @Model.Phone
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Email
        </dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Email))
            {
                <span class="text-muted">No email entered</span>
            }
            else
            {
                @Model.Email
            }
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Created At
        </dt>
        <dd class="col-sm-9">
            @Model.CreatedAt.ToString("dd MMM yyyy")
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Business
        </dt>
        <dd class="col-sm-9">
            @(Model.Business != null ? "Linked business record" : "No business linked")
        </dd>

    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.ClientId" class="btn btn-warning fw-bold">Edit</a>
    <a asp-action="ClientList" class="gw-back-link ms-2">Back to Clients</a>
</div>