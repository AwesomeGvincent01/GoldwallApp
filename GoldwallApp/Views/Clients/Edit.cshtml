@model GoldwallApp.Models.Client

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Edit Client";
    ViewData["ActivePage"] = "Clients";
}

<h1>Edit Client</h1>

<p class="text-muted">
    Update the saved contact details for this client.
</p>

<div class="gw-crud-card gw-form-width">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="ClientId" />

        <div class="form-group">
            <label asp-for="BusinessId" class="control-label">Business</label>
            <select asp-for="BusinessId" class="form-control" asp-items="ViewBag.BusinessId"></select>
            <span asp-validation-for="BusinessId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone" class="control-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CreatedAt" class="control-label"></label>
            <input asp-for="CreatedAt" class="form-control" />
            <span asp-validation-for="CreatedAt" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <input type="submit" value="Save" class="btn btn-warning fw-bold" />
            <a asp-action="ClientList" class="gw-back-link ms-2">Back to Clients</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}