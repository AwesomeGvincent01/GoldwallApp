@model IEnumerable<GoldwallApp.Models.DefectReport>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SurfaceId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DefectTypeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReportedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Severity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SuspectedCauseEventId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FixEventId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SurfaceId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DefectTypeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReportedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Severity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuspectedCauseEventId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FixEventId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DefectReportId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DefectReportId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DefectReportId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
