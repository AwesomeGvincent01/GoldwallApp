@{
    ViewData["Title"] = "Goldwall";
}

<style>
    body {
        margin: 0;
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(255, 226, 130, 0.35), transparent 35%), linear-gradient(135deg, #fffdf2 0%, #fff7d6 45%, #f4e7b3 100%);
    }

    .landing-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 120px;
        padding: 40px;
    }

    .landing-logo {
        max-width: 620px;
        width: 45vw;
    }

    .landing-buttons {
        display: flex;
        flex-direction: column;
        gap: 70px;
    }

    .image-button {
        display: block;
        width: 420px;
        height: 150px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }

    .login-button {
        background-image: url('/images/ui/login.png');
    }

        .login-button:hover {
            background-image: url('/images/ui/loginhover.png');
        }

    .register-button {
        background-image: url('/images/ui/register.png');
    }

        .register-button:hover {
            background-image: url('/images/ui/registerhover.png');
        }
</style>

<div class="landing-page">
    <img src="/images/ui/goldwall.png" class="landing-logo" alt="Goldwall logo" />

    <div class="landing-buttons">
        <a asp-area="Identity" asp-page="/Account/Login" class="image-button login-button" aria-label="Login"></a>

        <a asp-area="Identity" asp-page="/Account/Register" class="image-button register-button" aria-label="Register"></a>
    </div>
</div>