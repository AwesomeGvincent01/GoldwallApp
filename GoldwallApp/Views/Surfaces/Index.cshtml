@model IEnumerable<GoldwallApp.Models.Surface>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SurfaceType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Label)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AreaM2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubstrateType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SurfaceType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Label)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AreaM2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubstrateType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Room.RoomId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SurfaceId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SurfaceId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SurfaceId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
