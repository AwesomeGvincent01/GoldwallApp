@model GoldwallApp.Models.WorkEvent

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Edit Work Event";
    ViewData["ActivePage"] = "WorkEvents";
}

<h1>Edit Work Event</h1>

<p class="text-muted">
    Update the saved details for this work event.
</p>

<div class="gw-crud-card gw-form-width">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
             <input type="hidden" asp-for="WorkEventId" />
            <div class="form-group">
            <label asp-for="SurfaceId" class="control-label">Surface</label>
            <select asp-for="SurfaceId" class="form-control" asp-items="ViewBag.SurfaceId"></select>
            <span asp-validation-for="SurfaceId" class="text-danger"></span>
        </div>
             <div class="form-group">
            <label asp-for="UserId" class="control-label">User</label>
            <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
           <div class="form-group">
            <label asp-for="EventTypeId" class="control-label">Event Type</label>
            <select asp-for="EventTypeId" class="form-control" asp-items="ViewBag.EventTypeId"></select>
            <span asp-validation-for="EventTypeId" class="text-danger"></span>
        </div>
            <div class="form-group">
            <label asp-for="StartedAt" class="control-label"></label>
            <input asp-for="StartedAt" class="form-control" />
            <span asp-validation-for="StartedAt" class="text-danger"></span>
        </div>
            <div class="form-group">
            <label asp-for="EndedAt" class="control-label"></label>
            <input asp-for="EndedAt" class="form-control" />
            <span asp-validation-for="EndedAt" class="text-danger"></span>
        </div>
            <<div class="form-group">
            <label asp-for="Notes" class="control-label"></label>
            <input asp-for="Notes" class="form-control" />
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
            <div class="form-group mt-3">
            <input type="submit" value="Save" class="btn btn-warning fw-bold" />
            <a asp-action="WorkEventList" class="gw-back-link ms-2">Back to Work Events</a>
        </div>
        </form>
    </div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
