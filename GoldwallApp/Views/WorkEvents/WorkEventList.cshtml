@model GoldwallApp.ViewModels.WorkEventsViewModel

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Work Events";
}

<style>
    body {
        background-image: linear-gradient(rgba(255,253,242,0.88), rgba(244,231,179,0.92)), url('/images/ui/GWBackground.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .goldwall-card {
        background-color: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(150, 120, 35, 0.18);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);
    }

    .goldwall-heading {
        font-weight: 800;
        color: #4a3a12;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .summary-number {
        font-size: 1.7rem;
        font-weight: 800;
        color: #5a4510;
    }

    .table th {
        color: #4a3a12;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="goldwall-heading">Work Events</h1>
            <p class="text-muted mb-0">
                View logged plastering activity across job surfaces.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-bold">
            Log Work Event
        </a>
    </div>

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Total Work Events</div>
                <div class="summary-number">@Model.TotalWorkEventsCount</div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Today</div>
                <div class="summary-number">@Model.TodayWorkEventsCount</div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Completed</div>
                <div class="summary-number">@Model.CompletedWorkEventsCount</div>
            </div>
        </div>

    </div>

    <div class="goldwall-card p-3">

        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Notes</th>
                    <th>Surface</th>
                    <th>Event Type</th>
                    <th>Started</th>
                    <th>Ended</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var workEvent in Model.WorkEventsList)
                {
                    <tr>
                        <td class="fw-bold">
                            @if (string.IsNullOrWhiteSpace(workEvent.Notes))
                            {
                                <span class="text-muted">No notes entered</span>
                            }
                                      else
                            {
                                @workEvent.Notes
                            }
                        </td>

                     <td>
                      @workEvent.Surface?.Label
                    </td>

                        <td>
                            Event Type @workEvent.EventTypeId
                        </td>

                     <td>
                   @workEvent.StartedAt.ToString("dd MMM yyyy, h:mm tt")
                     </td>

                    <td>
                      @workEvent.EndedAt.ToString("dd MMM yyyy, h:mm tt")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@workEvent.WorkEventId" class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-action="Edit" asp-route-id="@workEvent.WorkEventId" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@workEvent.WorkEventId" class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>