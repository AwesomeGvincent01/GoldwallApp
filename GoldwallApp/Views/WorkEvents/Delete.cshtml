@model GoldwallApp.Models.WorkEvent

@{
    Layout = "~/Views/Shared/_GoldwallLayout.cshtml";
    ViewData["Title"] = "Delete Work Event";
    ViewData["ActivePage"] = "WorkEvents";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this work event?</h3>

    <h4>WorkEvent</h4>
    <hr />
    <div class="gw-crud-card">
    <dl class="row mb-0">
        <dt class="col-sm-3 gw-detail-label">
            Started At
        </dt>
        <dd class="col-sm-9">
            @Model.StartedAt.ToString("dd MMM yyyy, h:mm tt")
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Ended At
        </dt>
        <dd class="col-sm-9">
            @Model.EndedAt.ToString("dd MMM yyyy, h:mm tt")
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Notes
        </dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.Notes))
            {
                <span class="text-muted">No notes entered</span>
            }
            else
            {
                @Model.Notes
            }
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Surface
        </dt>
        <dd class="col-sm-9">
            @Model.Surface?.Label
        </dd>

        <dt class="col-sm-3 gw-detail-label">
            Event Type
        </dt>
        <dd class="col-sm-9">
            @Model.EventType?.Name
        </dd>

    </dl>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="WorkEventId" />
    <input type="submit" value="Delete" class="btn btn-danger fw-bold" />
    <a asp-action="WorkEventList" class="gw-back-link ms-2">Back to Work Events</a>
</form>
