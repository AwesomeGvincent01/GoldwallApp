@model GoldwallApp.ViewModels.JobsOverviewViewModel

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml"; ViewData["Title"] = "Jobs";

}

<style>
    body {
     background-image: linear-gradient(rgba(255, 253, 242, 0.88), rgba(244, 231, 179, 0.92)), url('/images/ui/GWBackground.png');
                      background-size: cover;
    background-position: center;
        background-attachment: fixed;
    }

    h1 {
     font-weight: 800;
     color: #4a3a12;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .card {
    background-color: rgba(255, 255, 255, 0.86);
 border: 1px solid rgba(150, 120, 35, 0.18);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);

    }

    .goldwall-btn

    {
   display: inline-block;
        padding: 10px 16px;
     border-radius: 12px;
       background: rgba(255, 196, 0, 0.75);
      border: 1px solid rgba(150, 120, 35, 0.25);
        color: #2e2508;
        text-decoration: none;
        font-weight: 800;
    }

        .goldwall-btn:hover {
            background: rgba(255, 196, 0, 0.95);
            color: #2e2508;
        
        
        }

    .goldwall-small-btn {
     padding: 5px 10px;
    border-radius: 9px;
                      background: rgba(255, 196, 0, 0.45);
    border: 1px solid rgba(150, 120, 35, 0.25);
    color: #2e2508;
  text-decoration: none;
        font-weight: 700;
    }
</style>

<h1>Jobs</h1>
<p>Manage current, planned, and completed plastering work.</p>

<div class="mb-4">
    <a asp-controller="Jobs" asp-action="Create" class="goldwall-btn">+ Create Job</a>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card card-body">
            <h5>Total Jobs</h5>
            <h2>@Model.TotalJobsCount</h2>
        </div>
    </div>

    <div class="col">
        <div class="card card-body">
            <h5>Active Jobs</h5>
            <h2>@Model.ActiveJobsCount</h2>
        </div>
    </div>

    <div class="col">
        <div class="card card-body">
            <h5>Planned Jobs</h5>
            <h2>@Model.PlannedJobsCount</h2>
        </div>
    </div>

    <div class="col">
        <div class="card card-body">
            <h5>Completed Jobs</h5>
            <h2>@Model.CompletedJobsCount</h2>
        </div>
    </div>
</div>

<div class="card card-body mb-4">
    <div class="row">
        <div class="col">
            <input class="form-control" placeholder="Search jobs..." />
        </div>

        <div class="col">
            <select class="form-control">
                <option>Status: All</option> <!-- these options/search are still purely visual. will be implemented later -->
                <option>Active</option>
                <option>Planned</option>
                <option>Completed</option>
            </select>
        </div>

        <div class="col">
            <select class="form-control">
                <option>Client: All</option>
            </select>
        </div>

        <div class="col">
            <button class="btn btn-outline-secondary w-100">Clear Filters</button>
        </div>
    </div>
</div>

<div class="card card-body">
    <h4>Job List</h4>

    <table class="table table-sm">
        <thead>
            <tr>
              <th>Job Title</th>
              <th>Client</th>
        <th>Address</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
         @foreach (var job in Model.Jobs)
            {
                <tr>
                  <td>@job.Title</td>
                    <td>@job.Client?.Name</td>
                    <td>@job.Address</td>
                  <td>@job.Status</td>
                    <td>
                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobId" class="goldwall-small-btn">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>