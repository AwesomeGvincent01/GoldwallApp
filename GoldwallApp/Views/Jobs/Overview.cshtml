@model GoldwallApp.ViewModels.JobsOverviewViewModel

@{
    Layout = "~/Views/Shared/GoldwallLayout.cshtml";
    ViewData["Title"] = "Jobs";
    ViewData["ActivePage"] = "Jobs";
}

<style>
    body {
     background-image: linear-gradient(rgba(255, 253, 242, 0.88), rgba(244, 231, 179, 0.92)), url('/images/ui/GWBackground.png');
                      background-size: cover;
    background-position: center;
        background-attachment: fixed;
    }

    h1 {
     font-weight: 800;
     color: #4a3a12;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .card {
    background-color: rgba(255, 255, 255, 0.86);
 border: 1px solid rgba(150, 120, 35, 0.18);
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);

    }

    .goldwall-btn

    {
   display: inline-block;
        padding: 10px 16px;
     border-radius: 12px;
       background: rgba(255, 196, 0, 0.75);
      border: 1px solid rgba(150, 120, 35, 0.25);
        color: #2e2508;
        text-decoration: none;
        font-weight: 800;
    }

        .goldwall-btn:hover {
            background: rgba(255, 196, 0, 0.95);
            color: #2e2508;
        
        
        }

    .goldwall-small-btn {
     padding: 5px 10px;
    border-radius: 9px;
                      background: rgba(255, 196, 0, 0.45);
    border: 1px solid rgba(150, 120, 35, 0.25);
    color: #2e2508;
  text-decoration: none;
        font-weight: 700;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1>Jobs</h1>
            <p class="text-muted mb-0">
                Manage current, planned, and completed plastering work.
            </p>
        </div>

        <a asp-controller="Jobs" asp-action="Create" class="btn btn-warning fw-bold">
            Create Job
        </a>
    </div>

    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Total Jobs</div>
                <div class="summary-number">@Model.TotalJobsCount</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Active Jobs</div>
                <div class="summary-number">@Model.ActiveJobsCount</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Planned Jobs</div>
                <div class="summary-number">@Model.PlannedJobsCount</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="goldwall-card p-3">
                <div class="text-muted">Completed Jobs</div>
                <div class="summary-number">@Model.CompletedJobsCount</div>
            </div>
        </div>

    </div>

    <div class="goldwall-card p-3 mb-4">
        <div class="row">
            <div class="col-md-3 mb-2">
                <input class="form-control" placeholder="Search jobs..." />
            </div>

            <div class="col-md-3 mb-2">
                <select class="form-control">
                    <option>Status: All</option>
                    <option>Active</option>
                    <option>Planned</option>
                    <option>Completed</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <select class="form-control">
                    <option>Client: All</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-secondary w-100">Clear Filters</button>
            </div>
        </div>

        <p class="text-muted mb-0 mt-2">
            Filter controls are visual placeholders and will be implemented later.
        </p>
    </div>

    <div class="goldwall-card p-3">

        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Client</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td class="fw-bold">@job.Title</td>

                        <td>@job.Client?.Name</td>

                        <td>@job.Address</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                @job.Status
                            </span>
                        </td>

                        <td class="text-end">
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-controller="Jobs" asp-action="Delete" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>