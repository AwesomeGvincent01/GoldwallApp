@model GoldwallApp.Models.Job

@{
    ViewData["Title"] = "Details";

}

<style>
  body {
    background-image: linear-gradient(rgba(255, 253, 242, 0.88), rgba(244, 231, 179, 0.92)), url('/images/ui/GWBackground.png');
     background-size: cover;
    background-position: center;
     background-attachment: fixed;
    }

  h1 {
    font-weight: 800;
   color: #4a3a12;
     text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
  }

  .card {
     background-color: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(150, 120, 35, 0.18);
      border-radius: 16px;
     box-shadow: 0 8px 18px rgba(80, 60, 10, 0.10);
    }
</style>

<h1>@Model.Title</h1>
<p>Job detail/planned plastering information</p>

<div class="card card-body mb-4">
    <h4>Job Info</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">

            <span class="badge bg-warning text-dark">
            @Html.DisplayFor(model => model.Status)
            </span>

        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.StartDatePlanned)
        </dt>
        <dd class="col-sm-9">
            @Model.StartDatePlanned.ToString("dd MMM yyyy")
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.EndDatePlanned)
        </dt>
        <dd class="col-sm-9">
            <dd class = "col-sm-10">
            @Model.EndDatePlanned.ToString("dd MMM yyyy")
        </dd>
        <dt class="col-sm-3">
                Business ID
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Business.BusinessId)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Client)
        </dt>
        <dd class="col-sm-9">
            @Model.Client?.Name
        </dd>
    </dl>
</div>
<div class="d-flex gap-2">
    <a asp-action="Edit" class="btn btn-warning fw-bold" asp-route-id="@Model?.JobId">Edit</a>
        <a asp-action="Overview" class="btn btn-warning fw-bold">Back to Jobs</a>
</div>
