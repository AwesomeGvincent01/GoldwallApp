@page
@model RegisterModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body {
        margin: 0;
        min-height: 100vh;
        overflow: hidden;
        background-image: url('/images/ui/GWBackground.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
        box-sizing: border-box;
    }

    .auth-box {
        width: 100%;
        max-width: 1120px;
        padding: 25px 70px;
        text-align: center;
    }

    .auth-logo {
        max-width: 560px;
        width: 45vw;
        margin-bottom: 15px;
    }

    .auth-title {
        font-weight: 800;
        color: #4a3a12;
        margin-bottom: 20px;
        font-size: 3rem;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .auth-input {
        height: 82px;
        font-size: 1.8rem;
        border-radius: 18px;
        border: 3px solid #d6b94c;
    }

    .register-image-button {
        width: 520px;
        height: 185px;
        border: none;
        background-color: transparent;
        background-image: url('/images/ui/register.png');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }

        .register-image-button:hover {
            background-image: url('/images/ui/registerhover.png');
        }

    .auth-links {
        margin-top: 20px;
        font-size: 1.2rem;
    }


        .auth-links a {
            color: #4a3a12;
            font-weight: 700;
        }


    ..exit-button {
        position: fixed;
        left: 45px;
        top: 35px;
        display: block;
        padding: 12px 22px;
        border-radius: 12px;
        background: rgba(255, 196, 0, 0.75);
        border: 2px solid rgba(150, 120, 35, 0.35);
        color: #2e2508;
        text-decoration: none;
        font-weight: 900;
        font-size: 1.4rem;
    }

    .exit-button:hover {
        background: rgba(255, 196, 0, 0.95);
        color: #2e2508;
        transform: scale(1.02);
    }
</style>

<a asp-controller="Home" asp-action="Landing" class="exit-button" aria-label="go back to landing page">EXIT</a>
<div class="auth-page">
    <div class="auth-box">
        <img src="/images/ui/goldwall.png" class="auth-logo" alt="Goldwall logo" />

        <h1 class="auth-title">Register</h1>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

        <div class="form-floating mb-4">
            <input asp-for="Input.FirstName" class="form-control auth-input" autocomplete="given-name" aria-required="true" placeholder="First Name" />
            <label asp-for="Input.FirstName">First Name</label>
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.LastName" class="form-control auth-input" autocomplete="family-name" aria-required="true" placeholder="Last Name" />
            <label asp-for="Input.LastName">Last Name</label>
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.PhoneNumber" class="form-control auth-input" autocomplete="tel" placeholder="Phone Number" />
            <label asp-for="Input.PhoneNumber">Phone Number</label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <select asp-for="Input.Role" class="form-control auth-input" aria-required="true">
                <option value="Admin">Admin</option>
            </select>
            <label asp-for="Input.Role">Role</label>
            <span asp-validation-for="Input.Role" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.BusinessInviteCode" class="form-control auth-input" aria-required="true" placeholder="Business Invite Code" />
            <label asp-for="Input.BusinessInviteCode">Business Invite Code</label>
            <span asp-validation-for="Input.BusinessInviteCode" class="text-danger"></span>
        </div>

       
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Password" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="register-image-button" aria-label="Register"></button>

            <div class="auth-links">
                <p>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account? Log in</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}