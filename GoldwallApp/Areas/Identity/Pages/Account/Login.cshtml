@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Log in";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body {
        margin: 0;
     min-height: 100vh;
   overflow: hidden;
  background-image: url('/images/ui/GWBackground.png');
   background-size: cover;
       background-position: center;
        background-repeat: no-repeat;
    }
   

   .auth-page {
 min-height: 100vh;
   display: flex;
 align-items: center;
   justify-content: center;
    padding: 35px;
    box-sizing: border-box;
}

    .auth-box {
        width: 100%;
        max-width: 1120px;
        padding: 45px 70px;
        text-align: center;
    }

    .auth-logo {
        max-width: 680px;
        width: 55vw;
        margin-bottom: 25px;
    }

    .auth-title {
        font-weight: 800;
        color: #4a3a12;
        margin-bottom: 25px;
        text-shadow: 1px 1px 0 #d6b94c, 2px 2px 0 rgba(0, 0, 0, 0.12);
    }

    .auth-input {
        height: 90px;
        font-size: 2rem;
        border-radius: 18px;
        border: 3px solid #d6b94c;
    }

    .login-image-button {
        width: 520px;
        height: 185px;
        border: none;
        background-color: transparent;
        background-image: url('/images/ui/login.png');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }

        .login-image-button:hover {
            background-image: url('/images/ui/loginhover.png');
            transform: scale(1.02);
        }


    .auth-links {
        margin-top: 20px;
    }

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 15px 0 25px 0;
        font-size: 1.4rem;
        font-weight: 600;
    }

    .exit-button {
    position: fixed;
    left: 45px;
    top: 35px;
    display: block;
    padding: 12px 22px;
    border-radius: 12px;
    background: rgba(255, 196, 0, 0.75);
    border: 2px solid rgba(150, 120, 35, 0.35);
    color: #2e2508;
    text-decoration: none;
    font-weight: 900;
    font-size: 1.4rem;
}

                    .exit-button:hover {
                background: rgba(255, 196, 0, 0.95);
                  color: #2e2508;
                  transform: scale(1.02);
                }

</style>

<a asp-controller="Home" asp-action="Landing" class="exit-button" aria-label="go back to landing page">EXIT</a>
<div class="auth-page">
    <div class="auth-box">
        <img src="/images/ui/goldwall.png" class="auth-logo" alt="Goldwall logo" />

        <h1 class="auth-title">Log In</h1>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="form-label">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="login-options">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
                <span class="text-muted">Forgot password?</span>
            </div>

            <button id="login-submit" type="submit" class="login-image-button" aria-label="Log in"></button>

            <div class="auth-links">
                <p>
                    <span class="text-muted">Forgot password?</span>
                </p>
                <p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}